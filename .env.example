DATABASE_URL=sqlite:///data/open-casting.sqlite
# Optional shared cache. Required for multiple web workers.
REDIS_URL=""
# Generate with: python -m app.security hash-password
STUDIO_PASSWORD_HASH=""
# Generate a random key for deployments. Locally a key is created in data/.
SESSION_SECRET=""
# Public sponsor inquiry contact shown on /sponsor.
SPONSOR_CONTACT=""
COOKIE_SECURE=false
# Proxy addresses whose X-Forwarded-For uvicorn trusts. Never use * on a public host: the left entry is client-written.
FORWARDED_ALLOW_IPS=127.0.0.1
# Edge-set header used as the client IP for rate limits. Render (behind Cloudflare): True-Client-IP. Empty: socket peer.
CLIENT_IP_HEADER=
# Render sets PORT=10000; omit locally to scan 8900-8999.
# PORT=10000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Loose IP backstop; temporarily raise only on an isolated load-test stack.
RATE_LIMIT_IP=300
# When nonempty, /metrics requires Authorization: Bearer <value>.
METRICS_TOKEN=""
# Used by `python -m app.db init`, never by web instances.
SEED_DEMO=false
# Only the one-shot workflow trigger needs these. Never commit real values.
RENDER_API_KEY=""
RENDER_WORKFLOW_SLUG=""
